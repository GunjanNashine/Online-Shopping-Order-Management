<%- include('partials/header') %>

<main class="site-main">
  <div class="container">
    <div style="margin-bottom: 24px;">
      <a href="/products" class="nav-link" style="font-size: 13px;">&larr; Back to Catalogue</a>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; background: #FFFFFF; border: 1px solid var(--color-card-border); border-radius: var(--radius-lg); padding: 48px; margin-bottom: 48px; align-items: center;">
      <!-- Product Image -->
      <div style="border-radius: var(--radius-md); overflow: hidden; background: var(--color-linen-surface); height: 440px;">
        <img src="<%= product.image_url %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;">
      </div>

      <!-- Product Information -->
      <div>
        <span class="product-category-tag"><%= product.category %> Collection</span>
        <h1 style="font-family: var(--font-display); font-size: 36px; color: var(--color-forest-deep); margin: 8px 0 16px;">
          <%= product.name %>
        </h1>
        <div style="font-size: 28px; font-weight: 700; color: var(--color-terracotta); margin-bottom: 20px;">
          $<%= product.price.toFixed(2) %>
        </div>

        <p style="font-size: 15px; color: var(--color-text-body); line-height: 1.8; margin-bottom: 24px;">
          <%= product.description %>
        </p>

        <div style="background: var(--color-sand-canvas); padding: 16px 20px; border-radius: var(--radius-md); margin-bottom: 24px; border: 1px solid var(--color-card-border);">
          <div style="font-size: 13px; font-weight: 600; color: var(--color-forest-deep); margin-bottom: 4px;">
            Inventory Availability:
          </div>
          <div style="font-size: 14px; font-weight: 700; color: <%= product.stock > 0 ? 'var(--color-success)' : 'var(--color-danger)' %>;">
            <% if (product.stock > 5) { %>
              In Stock (<%= product.stock %> items available)
            <% } else if (product.stock > 0) { %>
              Low Stock Warning (Only <%= product.stock %> remaining)
            <% } else { %>
              Sold Out / Out of Stock
            <% } %>
          </div>
        </div>

        <!-- Add to Cart Form -->
        <form action="/cart/add" method="POST">
          <input type="hidden" name="productId" value="<%= product.id %>">
          
          <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 24px;">
            <label for="quantity" style="font-weight: 600; font-size: 14px;">Quantity:</label>
            <input 
              type="number" 
              name="quantity" 
              id="quantity" 
              value="1" 
              min="1" 
              max="<%= product.stock %>"
              class="form-input" 
              style="width: 80px; text-align: center;"
              <%= product.stock <= 0 ? 'disabled' : '' %>
            >
          </div>

          <button 
            type="submit" 
            id="addToCartBtn" 
            class="btn btn-primary addToCartBtn" 
            style="width: 100%; padding: 14px 28px; font-size: 15px;"
            <%= product.stock <= 0 ? 'disabled' : '' %>
          >
            <%= product.stock <= 0 ? 'Item Currently Unavailable' : 'Add to Shopping Bag' %>
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
