<%- include('partials/header') %>

<main class="site-main">
  <div class="container">
    <!-- Header with Search Query Feedback -->
    <div class="section-header">
      <div>
        <h1 class="section-title">
          <% if (currentSearch) { %>
            Search Results for "<%= currentSearch %>"
          <% } else if (currentCategory && currentCategory !== 'All') { %>
            <%= currentCategory %> Collection
          <% } else { %>
            Artisanal Catalogue
          <% } %>
        </h1>
        <p class="section-subtitle">
          Showing <%= products.length %> handcrafted item<%= products.length === 1 ? '' : 's' %> in the studio index
        </p>
      </div>

      <% if (currentSearch || currentCategory !== 'All') { %>
        <a href="/products" class="btn btn-secondary" style="font-size: 12px; padding: 6px 14px;">
          Clear Filters ✕
        </a>
      <% } %>
    </div>

    <!-- Category Pills Navigation -->
    <div class="category-pills">
      <a href="/products<%= currentSearch ? '?search=' + encodeURIComponent(currentSearch) : '' %>" 
         class="category-pill <%= currentCategory === 'All' ? 'active' : '' %>">
        All Disciplines
      </a>
      <% categories.forEach(cat => { %>
        <a href="/products?category=<%= encodeURIComponent(cat) %><%= currentSearch ? '&search=' + encodeURIComponent(currentSearch) : '' %>" 
           class="category-pill <%= currentCategory === cat ? 'active' : '' %>">
          <%= cat %>
        </a>
      <% }); %>
    </div>

    <!-- Filter & Sort Bar -->
    <div class="catalogue-filter-bar">
      <form action="/products" method="GET" style="display: flex; gap: 12px; width: 100%; justify-content: space-between; flex-wrap: wrap;">
        <% if (currentSearch) { %>
          <input type="hidden" name="search" value="<%= currentSearch %>">
        <% } %>
        <% if (currentCategory && currentCategory !== 'All') { %>
          <input type="hidden" name="category" value="<%= currentCategory %>">
        <% } %>

        <div class="filter-group">
          <label for="sortSelect" style="font-size: 13px; font-weight: 600; color: var(--color-text-muted);">Sort By:</label>
          <select name="sort" id="sortSelect" class="filter-select" onchange="this.form.submit()">
            <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest Editions</option>
            <option value="price_asc" <%= currentSort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= currentSort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="name_asc" <%= currentSort === 'name_asc' ? 'selected' : '' %>>Alphabetical (A - Z)</option>
          </select>
        </div>

        <div style="font-size: 13px; color: var(--color-text-muted); align-self: center;">
          All pieces guaranteed authentic & studio-made
        </div>
      </form>
    </div>

    <!-- Product Grid -->
    <div class="product-grid" id="productGrid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <article class="product-card" data-product-id="<%= product.id %>">
            <div class="product-thumbnail-wrapper">
              <a href="/products/<%= product.id %>">
                <img src="<%= product.image_url %>" alt="<%= product.name %>" class="product-thumbnail" loading="lazy">
              </a>
              <% if (product.stock <= 0) { %>
                <span class="product-badge-stock badge-out-of-stock">Out of Stock</span>
              <% } else if (product.stock <= 5) { %>
                <span class="product-badge-stock badge-low-stock">Low Stock (<%= product.stock %>)</span>
              <% } else { %>
                <span class="product-badge-stock badge-in-stock">In Stock</span>
              <% } %>
            </div>

            <div class="product-info">
              <span class="product-category-tag"><%= product.category %></span>
              <h3 class="product-name">
                <a href="/products/<%= product.id %>"><%= product.name %></a>
              </h3>
              <p class="product-desc"><%= product.description %></p>

              <div class="product-footer">
                <span class="product-price">$<%= product.price.toFixed(2) %></span>
                <span class="product-stock-count" id="stockCount_<%= product.id %>">Available: <%= product.stock %></span>
              </div>

              <div class="card-actions">
                <form action="/cart/add" method="POST" style="width: 100%;">
                  <input type="hidden" name="productId" value="<%= product.id %>">
                  <input type="hidden" name="quantity" value="1">
                  <button 
                    type="submit" 
                    id="addToCartBtn"
                    class="btn-add-cart addToCartBtn" 
                    data-testid="addToCartBtn"
                    <%= product.stock <= 0 ? 'disabled' : '' %>
                  >
                    <%= product.stock <= 0 ? 'Out of Stock' : 'Add to Bag' %>
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }); %>
      <% } else { %>
        <!-- No Products Found State -->
        <div class="empty-state" id="noProductsFound">
          <div class="empty-icon">🍂</div>
          <h2 class="empty-title">No Matching Artisan Pieces Found</h2>
          <p class="empty-desc">
            We could not find any available objects matching "<%= currentSearch || currentCategory %>". Try refining your search keywords or browsing all categories.
          </p>
          <a href="/products" class="btn btn-primary">Browse Full Catalogue</a>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
