<%- include('partials/header') %>

<main class="site-main">
  <div class="container">
    <div class="empty-state" style="margin: 64px auto; max-width: 600px;">
      <div class="empty-icon">⚠️</div>
      <h1 class="empty-title">Studio Service Notice</h1>
      <p class="empty-desc">
        <%= typeof error !== 'undefined' && error ? error : 'An internal server issue prevented completing this operation. Our studio maintainers have been notified.' %>
      </p>
      <div style="display: flex; gap: 12px; justify-content: center;">
        <a href="/" class="btn btn-primary">Return to Homepage</a>
        <a href="/products" class="btn btn-secondary">Catalogue</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
