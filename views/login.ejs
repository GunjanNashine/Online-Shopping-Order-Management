<%- include('partials/header') %>

<main class="site-main">
  <div class="container">
    <div class="auth-wrapper">
      <div class="auth-header">
        <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-terracotta); font-weight: 700;">Account Access</span>
        <h1 class="auth-title">Welcome to Aura & Forma</h1>
        <p class="auth-subtitle">Sign in to manage your bag, checkout, and view order history</p>
      </div>

      <!-- Login Form with Stable IDs for Selenium Testing -->
      <form action="/login" method="POST" id="loginForm">
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="form-input" 
            placeholder="e.g. john@example.com" 
            required 
            autocomplete="email"
          >
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Account Password</label>
          <input 
            type="password" 
            name="password" 
            id="password" 
            class="form-input" 
            placeholder="••••••••" 
            required 
            autocomplete="current-password"
          >
        </div>

        <button type="submit" id="loginBtn" class="btn btn-primary" style="width: 100%; padding: 13px; font-size: 15px; margin-top: 10px;">
          Sign In
        </button>
      </form>

      <!-- Pre-seeded Demonstration Credentials -->
      <div style="background-color: var(--color-sand-canvas); border: 1px solid var(--color-card-border); border-radius: var(--radius-sm); padding: 14px; margin-top: 24px; font-size: 12px; color: var(--color-text-muted);">
        <strong style="color: var(--color-forest-deep); display: block; margin-bottom: 4px;">DevOps Practical Demonstration Logins:</strong>
        <div>👤 <strong>Demo Customer:</strong> <code>john@example.com</code> / <code>Customer@123</code></div>
        <div style="margin-top: 4px;">⚙️ <strong>Studio Admin:</strong> <code>admin@aurafoma.com</code> / <code>Admin@1234</code></div>
      </div>

      <div class="auth-footer">
        Don't have a studio account yet? 
        <a href="/register" class="auth-link">Create Account</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
